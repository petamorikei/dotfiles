{#- Desktops report by voice: VOICEPEAK (vpsay) on the main machine, VOICEVOX
    (vvsay) on the others. -#}
{%- set main = mise_env is defined and "main" in mise_env -%}
{%- set voice = mise_env is defined and "desktop" in mise_env -%}
{
  "cleanupPeriodDays": 99999,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1"
  },
  "advisorModel": "fable",
  "attribution": false,
  "dialogExpiry": "never",
  "permissions": {
    "allow": [
{%- if main %}
      "Skill(vp-reporter)",
      "Bash(vpsay *)",
{%- elif voice %}
      "Skill(vv-reporter)",
      "Bash(vvsay --bg --queue *)",
{%- endif %}
      "Bash(codex *)",
      "Bash(rg *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(python3 *)"
    ],
    "ask": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
{%- if os() == "macos" %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      },
{%- endif %}
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ env.HOME }}/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUse": [
{%- if os() == "macos" %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      },
{%- endif %}
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ env.HOME }}/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "{{ env.HOME }}/.atuin/bin/atuin hook claude-code"
          }
        ]
      }
    ]
{%- if voice %},
    "Notification": [
{%- if os() == "macos" %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      },
{%- endif %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "{% if main %}vpsay \"クロードからの通知があるわよ！\"{% else %}vvsay --bg --queue \"クロードからの通知があります\"{% endif %}",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "{% if main %}vpsay \"コンテキストを圧縮するわよ！\"{% else %}vvsay --bg --queue \"コンテキストを圧縮します\"{% endif %}",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
{%- if os() == "macos" %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      },
{%- endif %}
      {
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); echo \"$INPUT\" | jq -e '.stop_hook_active | not' > /dev/null && {% if main %}vpsay \"作業が完了したわよ！\"{% else %}vvsay --bg --queue \"作業が完了しました\"{% endif %}",
            "async": true
          }
        ]
      }
    ]
{%- endif %}
{%- if os() == "macos" %},
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.config/iterm2/cc-status\"",
            "async": true
          }
        ]
      }
    ]
{%- endif %}
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "language": "Japanese",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "normal",
  "verbose": false,
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
