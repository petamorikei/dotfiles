[user]
	name = {{ secret(name="git_name") }}
	email = {{ secret(name="git_email") }}
[credential]
{%- if os() == "macos" %}
	helper = osxkeychain
{%- else %}
	helper = store
{%- endif %}
[core]
	ignorecase = false
{%- if mise_env is defined and "work" in mise_env %}
{{ secret(name="git_work_config") }}
{%- endif %}
